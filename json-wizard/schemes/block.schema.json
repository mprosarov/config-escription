{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "default": "block",
      "title": "Тип компонента",
      "readonly": true
    },
    "orientation": {
      "type": "string",
      "title": "Ориентация",
      "enum": ["row", "column"]
    }
  },
  "required": ["id", "query"]
}
