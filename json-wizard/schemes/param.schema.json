{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": { 
      "type": "string", 
      "default": "param", 
      "title": "Тип компонента",
      "readonly":true
      
    },

    "id": { "type": "string" },
    "init": {
      "type": "object",
      "properties": {
        "valueType": { "type": "string" },
        "value": { "type": "string"}
      },
      "required": ["valueType", "value"]
    }
  },
  "required": ["id","type"]
}
