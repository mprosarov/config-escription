{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "default": "checkbox",
      "title": "Тип компонента",
      "readonly": true
    },
    "inline": {
      "type": "boolean",
      "title": "Отображение по горизонтали"
    },
    "items": {
      "type": "array",
      "title": "Элементы",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "ID"
          },

          "label": {
            "type": "string",
            "title": "Лэйбл"
          },
          "checked": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "title": "Активность элемента",
            "enum": ["disabled", "unabled"]
          },
          "value": {
            "type": "string",
            "title": "Значение"
          }
        },
        "required": []
      }
    }
  }
}
